# Meta Model API key for Muse Voice Transcribe
MODEL_API_KEY=replace_with_your_meta_model_api_key
# META_API_KEY is also accepted as an alias.

# Optional: required only for OpenAI transcription profiles or text post-processing
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_TEXT_MODEL=gpt-4.1-mini
